#!/bin/sh
#PBS -lwalltime=10:00:00
#PBS -lselect=1:ncpus=1:mem=10GB


# input directory
CASE="$HOME/test/assem_v2/5to3"

# output directory
OUTROOT="$CASE/output"
OUTDIR="$OUTROOT/run_${PBS_JOBID:-manual}"
mkdir -p "$OUTDIR"

# copy the case files into the run folder
rsync -a --exclude 'output/' "$CASE"/ "$OUTDIR"/

# change directory to run from the output folder
cd "$OUTDIR"

# optionally set a custom seed: submit with `qsub -v SEED=X trial_md.pbs where X is an integer
if [ -n "${SEED:-}" ]; then
  sed -E -i 's/^([[:space:]]*seed[[:space:]]*=[[:space:]]*).*/\1'"$SEED"'/' trap_input2
fi

# ---- your familiar pattern ----
input_file="$OUTDIR/trap_input2"
runcommand="$HOME/oxDNA/build/bin/oxDNA $input_file"
timeout 545m $runcommand
