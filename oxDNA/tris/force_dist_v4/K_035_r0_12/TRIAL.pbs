#!/bin/sh
#PBS -lwalltime=10:00:00
#PBS -lselect=1:ncpus=1:mem=10GB


# input directory
CASE="$HOME/test/fd_4/K_035_r0_12"

# output directory
OUTROOT="$CASE/output"
OUTDIR="$OUTROOT/run_${PBS_JOBID:-manual}"
mkdir -p "$OUTDIR"

cd "$CASE"

cp "input_only_traps_long_MD" "$OUTDIR/input_only_traps_long_MD"
cp "posttraps_relax_MD_last.conf" "$OUTDIR/posttraps_relax_MD_last.conf"
cp "top_5to3.top" "$OUTDIR/top_5to3.top"
cp "external.conf" "$OUTDIR/external.conf"

# change directory to run from the output folder
cd "$OUTDIR"

# optionally set a custom seed: submit with `qsub -v SEED=X trial_md.pbs where X is an integer
if [ -n "${SEED:-}" ]; then
  sed -E -i 's/^([[:space:]]*seed[[:space:]]*=[[:space:]]*).*/\1'"$SEED"'/' input_only_traps_long_MD
fi

# run the simulation - chat is it gay if you kiss your homies goodnight?
input_file="$OUTDIR/input_only_traps_long_MD"
runcommand="$HOME/oxDNA/build/bin/oxDNA $input_file"
timeout 545m $runcommand
